<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="AssignedSets">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="AssignedSet">
					<xs:complexType>
						<xs:attribute name="id" type="xs:string" use="required" />
						<xs:attribute name="character_id" type="xs:string" use="required" />
					</xs:complexType>
				</xs:element>
				<xs:element name="AssignedHeroSets">
					<xs:complexType>
						<xs:sequence>
							<xs:element maxOccurs="unbounded" name="AssignedHeroSet">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Set">
											<xs:complexType>
												<xs:attribute name="index" type="xs:unsignedByte" use="required" />
												<xs:attribute name="culture" type="xs:string" use="required" />
											</xs:complexType>
										</xs:element>
									</xs:sequence>
									<xs:attribute name="character_id" type="xs:string" use="required" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="AssignedClanSets">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="AssignedClanSet">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Set">
											<xs:complexType>
												<xs:attribute name="index" type="xs:unsignedByte" use="required" />
												<xs:attribute name="culture" type="xs:string" use="required" />
											</xs:complexType>
										</xs:element>
									</xs:sequence>
									<xs:attribute name="clan_id" type="xs:string" use="required" />
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>